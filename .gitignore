# ═══════════════════════════════════════════════════════════════════════════════
# HalluDet-Lite .gitignore  –  keeps the repo lightweight for GitHub
# ═══════════════════════════════════════════════════════════════════════════════

# ── Virtual environments (NEVER commit these – GBs of binaries) ───────────────
halludet_env/
tmp_venv/
venv/
.venv/
env/
.conda/
*.egg
*.egg-info/

# ── Model weights & checkpoints (too large for GitHub – use HF Hub or DVC) ────
models/
*.pt
*.bin
*.safetensors
*.onnx
*.ckpt

# ── Data – raw & large generated files (regenerated by scripts) ───────────────
data/raw/
data/knowledge_base/
data/processed/*.npy
data/processed/*.pkl
data/processed/nli_dataset.json
# NOTE: data/processed/dpo_dataset.json (9.6 MB) is kept –
#       it is the core DPO training file. Remove this comment to ignore it too.

# ── HuggingFace cache ─────────────────────────────────────────────────────────
.hf_cache/

# ── Logs & experiment tracking ────────────────────────────────────────────────
logs/
*.log
wandb/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
dist/
build/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── Temporary / scratch files ─────────────────────────────────────────────────
tmp_inspect.py
scratch_vram.py
test_dataset_loader.py
test_hf_dataset.py

# ── Secrets / credentials ─────────────────────────────────────────────────────
.env
*.pem
*.key
secrets.json
